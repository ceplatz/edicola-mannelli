rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo i due account ufficiali. Qualsiasi altro utente Firebase viene rifiutato.
    function titolare() {
      return request.auth != null
        && request.auth.token.email.lower() == 'proprietario@edicolamannelli.com';
    }
    function personale() {
      return request.auth != null
        && request.auth.token.email.lower() == 'staff@edicolamannelli.com';
    }

    // Il personale può SOLO spostare pezzi tra negozio e magazzino:
    // il totale non cambia e nessuna quantità scende sotto zero.
    function soloTrasferimento() {
      let n = request.resource.data;
      let o = resource.data;
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['qtaNegozio', 'qtaMagazzino', 'aggiornatoIl'])
        && n.qtaNegozio is int && n.qtaMagazzino is int
        && n.qtaNegozio >= 0 && n.qtaMagazzino >= 0
        && n.qtaNegozio + n.qtaMagazzino == o.qtaNegozio + o.qtaMagazzino;
    }

    // Vendita: il personale può togliere pezzi dal NEGOZIO solo insieme a una vendita nuova (stesso salvataggio),
    // e rimetterli solo annullando una vendita esistente. La quantità può andare sotto zero: vuol dire «da ricontare».
    function soloVenditaStock() {
      let n = request.resource.data;
      let o = resource.data;
      let vend = /databases/$(database)/documents/vendite/$(request.resource.data.ultimaVenditaId);
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['qtaNegozio', 'aggiornatoIl', 'ultimaVenditaId'])
        && n.qtaNegozio is int && n.ultimaVenditaId is string
        && ((n.qtaNegozio < o.qtaNegozio && o.qtaNegozio - n.qtaNegozio <= 500
             && !exists(vend) && existsAfter(vend))
         || (n.qtaNegozio > o.qtaNegozio && n.qtaNegozio - o.qtaNegozio <= 500
             && exists(vend) && get(vend).data.annullata == false
             && getAfter(vend).data.annullata == true));
    }

    match /prodotti/{id} {
      allow read: if titolare() || personale();
      allow create, delete: if titolare();
      allow update: if titolare() || (personale() && (soloTrasferimento() || soloVenditaStock()));

      // Prezzo di acquisto: visibile SOLO al titolare.
      match /privato/{doc} {
        allow read, write: if titolare();
      }
    }

    // Per il report: il titolare può leggere tutti i prezzi di acquisto con una sola richiesta.
    match /{path=**}/privato/{doc} {
      allow read: if titolare();
    }

    // Storico datato (carichi e vendite, anche importati da foglio). Solo il titolare.
    match /storico/{id} {
      allow read, write: if titolare();
    }

    // Fatture caricate (i file stanno in Firebase Storage; qui data, distributore, nota e percorsi). Solo il titolare.
    match /fatture/{id} {
      allow read, write: if titolare();
    }

    // Foto dei prodotti (versione grande; la miniatura sta nel prodotto). Le vedono tutti, le modifica solo il titolare.
    match /foto/{id} {
      allow read: if titolare() || personale();
      allow write: if titolare();
    }

    // Distributori: elenco per il menu a tendina dei prodotti. Lo vedono tutti, lo modifica solo il titolare.
    match /distributori/{id} {
      allow read: if titolare() || personale();
      allow write: if titolare();
    }

    // Dipendenti e PIN (salvato come hash salato). Lo legge anche il personale
    // per verificare il PIN sul dispositivo; lo modifica solo il titolare.
    match /personale/{id} {
      allow read: if titolare() || personale();
      allow write: if titolare();
    }

    // Giornate chiuse («sigillate») dalla titolare: dopo la chiusura non si registrano né si annullano vendite di quel giorno.
    function giornoChiuso(g) { return exists(/databases/$(database)/documents/giornate/$(g)); }
    match /giornate/{giorno} {
      allow read: if titolare() || personale();
      allow write: if titolare();
    }

    // Turni: chi lavora su quale computer. Il personale può aprirne uno e chiudere il proprio.
    match /turni/{id} {
      allow read: if titolare() || personale();
      allow create: if (titolare() || personale())
        && request.resource.data.keys().hasOnly(
             ['staffId', 'staffNome', 'postazione', 'giorno', 'ruolo', 'aperto', 'apertoLocale', 'chiusoIl'])
        && request.resource.data.aperto == request.time
        && request.resource.data.chiusoIl == null
        && request.resource.data.giorno is string && request.resource.data.giorno.size() == 10
        && request.resource.data.postazione is string && request.resource.data.postazione.size() <= 30
        && request.resource.data.ruolo == (titolare() ? 'titolare' : 'personale')
        && (titolare()
            || exists(/databases/$(database)/documents/personale/$(request.resource.data.staffId)));
      allow update: if titolare()
        || (personale()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chiusoIl'])
            && resource.data.chiusoIl == null
            && request.resource.data.chiusoIl == request.time);
      allow delete: if false;
    }

    // Vendite: un documento per scontrino (righe con quantità e prezzo del momento). Mai modificate:
    // si possono solo ANNULLARE (resta visibile, segnata come annullata) - il personale entro 10 minuti, la titolare sempre.
    match /vendite/{id} {
      allow read: if titolare() || personale();
      allow create: if (titolare() || personale())
        && request.resource.data.keys().hasOnly(
             ['giorno', 'turnoId', 'staffId', 'staffNome', 'postazione', 'righe', 'pezzi', 'totale',
              'ruolo', 'quando', 'quandoLocale', 'annullata'])
        && request.resource.data.quando == request.time
        && request.resource.data.annullata == false
        && request.resource.data.giorno is string && request.resource.data.giorno.size() == 10
        && !giornoChiuso(request.resource.data.giorno)
        && request.resource.data.turnoId is string
        && request.resource.data.righe is list
        && request.resource.data.righe.size() >= 1 && request.resource.data.righe.size() <= 60
        && request.resource.data.pezzi is int && request.resource.data.pezzi >= 1 && request.resource.data.pezzi <= 2000
        && request.resource.data.totale is number && request.resource.data.totale >= 0
        && request.resource.data.postazione is string && request.resource.data.postazione.size() <= 30
        && request.resource.data.quandoLocale is timestamp
        && request.resource.data.quandoLocale <= request.time + duration.value(10, 'm')
        && request.resource.data.quandoLocale >= request.time - duration.value(45, 'd')
        && request.resource.data.ruolo == (titolare() ? 'titolare' : 'personale')
        && (titolare()
            || exists(/databases/$(database)/documents/personale/$(request.resource.data.staffId)));
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['annullata', 'annullataIl', 'annullataDa'])
        && request.resource.data.annullata == true && resource.data.annullata == false
        && request.resource.data.annullataIl == request.time
        && !giornoChiuso(resource.data.giorno)
        && (titolare()
            || (personale() && request.time < resource.data.quando + duration.value(11, 'm')));
      allow delete: if false;
    }

    // Registro movimenti: lo legge SOLO il titolare. Si può aggiungere, mai modificare.
    // Tre tipi di riga:
    //  - spostamento tra negozio e magazzino (anche il personale, con le verifiche di sempre)
    //  - carico: pezzi arrivati dall'esterno (acquisti, primo inserimento) - solo il titolare
    //  - rettifica: correzione manuale di una quantità - solo il titolare
    // Solo il titolare può eliminare una riga (es. fatta per errore).
    function nuovo() { return request.resource.data; }
    function tipoRiga() { return nuovo().get('tipo', 'sposta'); }
    function sposta() {
      return tipoRiga() == 'sposta'
        && nuovo().da in ['magazzino', 'negozio']
        && nuovo().a in ['magazzino', 'negozio']
        && nuovo().da != nuovo().a
        && !('luogo' in nuovo()) && !('delta' in nuovo())
        && (titolare()
            || exists(/databases/$(database)/documents/personale/$(nuovo().staffId)));
    }
    function carico() {
      return titolare() && tipoRiga() == 'carico'
        && nuovo().da == 'esterno'
        && nuovo().a in ['magazzino', 'negozio']
        && !('luogo' in nuovo()) && !('delta' in nuovo());
    }
    function rettifica() {
      return titolare() && tipoRiga() == 'rettifica'
        && nuovo().luogo in ['magazzino', 'negozio']
        && nuovo().delta is int && nuovo().delta != 0
        && nuovo().qta == (nuovo().delta > 0 ? nuovo().delta : -nuovo().delta)
        && !('da' in nuovo()) && !('a' in nuovo());
    }
    match /movimenti/{id} {
      allow read: if titolare();
      allow create: if (titolare() || personale())
        && nuovo().keys().hasOnly(
             ['prodottoId', 'prodottoNome', 'codice', 'da', 'a', 'qta',
              'staffId', 'staffNome', 'ruolo', 'quando', 'quandoLocale', 'tipo', 'nota', 'luogo', 'delta'])
        && nuovo().quando == request.time
        && nuovo().qta is int && nuovo().qta > 0
        && nuovo().get('nota', '') is string && nuovo().get('nota', '').size() <= 120
        // ora reale dell'azione sul dispositivo (può essere precedente se la rete mancava): ragionevolmente vicina a quella del server
        && nuovo().get('quandoLocale', request.time) is timestamp
        && nuovo().get('quandoLocale', request.time) <= request.time + duration.value(10, 'm')
        && nuovo().get('quandoLocale', request.time) >= request.time - duration.value(45, 'd')
        && nuovo().ruolo == (titolare() ? 'titolare' : 'personale')
        && (sposta() || carico() || rettifica());
      allow update: if false;
      allow delete: if titolare();
    }
  }
}
