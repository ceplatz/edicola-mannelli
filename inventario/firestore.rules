rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo i due account ufficiali. Qualsiasi altro utente Firebase viene rifiutato.
    function titolare() {
      return request.auth != null
        && request.auth.token.email.lower() == 'proprietario@edicolamannelli.com';
    }
    function personale() {
      return request.auth != null
        && request.auth.token.email.lower() == 'staff@edicolamannelli.com';
    }

    // Il personale può SOLO spostare pezzi tra negozio e magazzino:
    // il totale non cambia e nessuna quantità scende sotto zero.
    function soloTrasferimento() {
      let n = request.resource.data;
      let o = resource.data;
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['qtaNegozio', 'qtaMagazzino', 'aggiornatoIl'])
        && n.qtaNegozio is int && n.qtaMagazzino is int
        && n.qtaNegozio >= 0 && n.qtaMagazzino >= 0
        && n.qtaNegozio + n.qtaMagazzino == o.qtaNegozio + o.qtaMagazzino;
    }

    match /prodotti/{id} {
      allow read: if titolare() || personale();
      allow create, delete: if titolare();
      allow update: if titolare() || (personale() && soloTrasferimento());

      // Prezzo di acquisto: visibile SOLO al titolare.
      match /privato/{doc} {
        allow read, write: if titolare();
      }
    }

    // Per il report: il titolare può leggere tutti i prezzi di acquisto con una sola richiesta.
    match /{path=**}/privato/{doc} {
      allow read: if titolare();
    }

    // Storico datato (carichi e vendite, anche importati da foglio). Solo il titolare.
    match /storico/{id} {
      allow read, write: if titolare();
    }

    // Fatture caricate (i file stanno in Firebase Storage; qui data, distributore, nota e percorsi). Solo il titolare.
    match /fatture/{id} {
      allow read, write: if titolare();
    }

    // Foto dei prodotti (versione grande; la miniatura sta nel prodotto). Le vedono tutti, le modifica solo il titolare.
    match /foto/{id} {
      allow read: if titolare() || personale();
      allow write: if titolare();
    }

    // Distributori: elenco per il menu a tendina dei prodotti. Lo vedono tutti, lo modifica solo il titolare.
    match /distributori/{id} {
      allow read: if titolare() || personale();
      allow write: if titolare();
    }

    // Dipendenti e PIN (salvato come hash salato). Lo legge anche il personale
    // per verificare il PIN sul dispositivo; lo modifica solo il titolare.
    match /personale/{id} {
      allow read: if titolare() || personale();
      allow write: if titolare();
    }

    // Registro movimenti: lo legge SOLO il titolare. Si può aggiungere, mai modificare.
    // Tre tipi di riga:
    //  - spostamento tra negozio e magazzino (anche il personale, con le verifiche di sempre)
    //  - carico: pezzi arrivati dall'esterno (acquisti, primo inserimento) - solo il titolare
    //  - rettifica: correzione manuale di una quantità - solo il titolare
    // Solo il titolare può eliminare una riga (es. fatta per errore).
    function nuovo() { return request.resource.data; }
    function tipoRiga() { return nuovo().get('tipo', 'sposta'); }
    function sposta() {
      return tipoRiga() == 'sposta'
        && nuovo().da in ['magazzino', 'negozio']
        && nuovo().a in ['magazzino', 'negozio']
        && nuovo().da != nuovo().a
        && !('luogo' in nuovo()) && !('delta' in nuovo())
        && (titolare()
            || exists(/databases/$(database)/documents/personale/$(nuovo().staffId)));
    }
    function carico() {
      return titolare() && tipoRiga() == 'carico'
        && nuovo().da == 'esterno'
        && nuovo().a in ['magazzino', 'negozio']
        && !('luogo' in nuovo()) && !('delta' in nuovo());
    }
    function rettifica() {
      return titolare() && tipoRiga() == 'rettifica'
        && nuovo().luogo in ['magazzino', 'negozio']
        && nuovo().delta is int && nuovo().delta != 0
        && nuovo().qta == (nuovo().delta > 0 ? nuovo().delta : -nuovo().delta)
        && !('da' in nuovo()) && !('a' in nuovo());
    }
    match /movimenti/{id} {
      allow read: if titolare();
      allow create: if (titolare() || personale())
        && nuovo().keys().hasOnly(
             ['prodottoId', 'prodottoNome', 'codice', 'da', 'a', 'qta',
              'staffId', 'staffNome', 'ruolo', 'quando', 'tipo', 'nota', 'luogo', 'delta'])
        && nuovo().quando == request.time
        && nuovo().qta is int && nuovo().qta > 0
        && nuovo().get('nota', '') is string && nuovo().get('nota', '').size() <= 120
        && nuovo().ruolo == (titolare() ? 'titolare' : 'personale')
        && (sposta() || carico() || rettifica());
      allow update: if false;
      allow delete: if titolare();
    }
  }
}
